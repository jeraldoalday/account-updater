PORT=3000

# GitHub token used to call the GitHub API (commits, events) and to clone
# private repos. Needs `repo` scope for private repos; a public-repo-only
# token works for public repos.
GITHUB_TOKEN=

# Alternative to GITHUB_TOKEN: authenticate as a GitHub App installation
# instead of a shared PAT (higher rate limits, no long-lived secret to
# leak). All three must be set together, or all left unset. Only used as
# the fallback when a request has no caller-supplied or GITHUB_TOKEN
# credential available.
GITHUB_APP_ID=
# Paste the PEM private key with literal \n in place of real newlines.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# GitLab personal or project access token, used to call the GitLab API and
# to clone private projects. `read_api` is enough for the API calls;
# `read_repository` is additionally needed to clone a private project.
# Unauthenticated calls work for public projects but are throttled hard.
GITLAB_TOKEN=

# Ceiling on a single outbound provider API call, in milliseconds.
# Default: 10000. Raise it for a slow self-hosted upstream; lowering it
# makes a stalled provider fail the check sooner instead of holding the
# request open.
PROVIDER_REQUEST_TIMEOUT_MS=

# When set, callers must send a matching `x-api-key` header on /eligibility
# requests. Leave unset for local development.
API_KEY=

# How long to cache an eligibility result per repo, in milliseconds.
# Default: 10 minutes. Only applies to requests that don't supply their own
# per-request token.
CACHE_TTL_MS=

# Cache backend: "memory" (default, per-process) or "redis" (shared across
# instances of the service). REDIS_URL is required when set to "redis".
CACHE_BACKEND=
REDIS_URL=

# Path to the SQLite database storing the evaluation audit trail (one row
# per evaluation actually performed: repo, timestamp, eligible, reasons).
# Default: ./data/history.db
HISTORY_DB_PATH=

# Rate limit applied to /eligibility, keyed by API key (or IP if none is
# set). Defaults: 20 requests per 60-second window.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=

# Comma-separated subset of the known languages (TypeScript, JavaScript,
# Python, Go, Rust) that count toward the primary-language and size checks.
# Defaults to all five. An unrecognized name fails fast at startup.
ELIGIBLE_LANGUAGES=

# Shutdown pacing. On SIGTERM the process keeps serving for
# SHUTDOWN_DRAIN_MS while GET /ready answers 503, so a load balancer can
# take it out of rotation before the listener closes; SHUTDOWN_GRACE_MS is
# the hard deadline for the whole shutdown, after which remaining
# connections are cut. Defaults: 5000 and 20000. Set the drain window to at
# least one readiness-probe interval.
SHUTDOWN_DRAIN_MS=
SHUTDOWN_GRACE_MS=

# Audit-trail retention. Evaluation rows older than HISTORY_RETENTION_DAYS
# are deleted by a sweep that runs at startup and every
# HISTORY_PRUNE_INTERVAL_MS after. Defaults: 90 days, every 6 hours. Set
# HISTORY_RETENTION_DAYS=0 to keep rows forever (e.g. when they're shipped
# off-box and the file is meant to grow).
HISTORY_RETENTION_DAYS=
HISTORY_PRUNE_INTERVAL_MS=
