{
  "name": "account-updater",
  "version": "1.1.0",
  "private": true,
  "description": "Eligibility check service for connecting a GitHub account/repo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "stats": "npm run build --silent && node dist/cli/stats.js",
    "loadtest": "npm run build --silent && node dist/cli/loadtest.js",
    "collection": "npm run build --silent && node dist/cli/genCollection.js",
    "doctor": "npm run build --silent && node dist/cli/doctor.js",
    "smoke": "npm run build --silent && node dist/cli/smoke.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^20.1.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "redis": "^4.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
